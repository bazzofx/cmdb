# Local development configuration. This file is gitignored.
# Do not put production secrets in this file.

AUTH_MODE=local
SESSION_TTL_HOURS=12

# First-run administrator (only used when the users table is empty).
# Set these in the OS environment, not here:
#   PowerShell: $env:cmdbUser = "admin@example.internal"
#   PowerShell: $env:cmdbPass = "<strong unique password>"
# Optional display name:
#   $env:cmdbName = "CMDB Administrator"
# The server refuses to start if cmdbUser/cmdbPass are missing on first run.

COOKIE_SECURE=0
TRUST_PROXY=0
APP_URL=http://localhost:3000

# Optional: bind address. Development defaults to 127.0.0.1; production to 0.0.0.0.
# HOST=127.0.0.1
# Optional: audit log cap (default 5000).
# AUDIT_LOG_LIMIT=5000
